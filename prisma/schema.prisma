generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Dealer {
  id        String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  code      String   @unique @db.NVarChar(50)
  name      String   @db.NVarChar(200)
  phone     String?  @db.NVarChar(30)
  region    String?  @db.NVarChar(100)
  status    String   @default("active") @db.NVarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  enrollments      CourseEnrollment[]
  attendances      Attendance[]
  examAssignments  ExamAssignment[]
  attempts         ExamAttempt[]
  materialProgress MaterialProgress[]
  practiceSessions PracticeSession[]

  @@index([region])
  @@map("dealers")
}

model User {
  id                 String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  email              String    @unique @db.NVarChar(320)
  name               String    @db.NVarChar(200)
  passwordHash       String?   @map("password_hash") @db.NVarChar(255)
  role               String    @default("dealer") @db.NVarChar(20)
  status             String    @default("active") @db.NVarChar(20)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  dealerId           String?   @map("dealer_id") @db.UniqueIdentifier
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  dealer           Dealer?           @relation(fields: [dealerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attempts         ExamAttempt[]
  practiceSessions PracticeSession[]
  auditLogs        AuditLog[]
  importJobs       ImportJob[]
  notifications    Notification[]

  @@index([dealerId])
  @@map("users")
}

model Notification {
  id        String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  userId    String    @map("user_id") @db.UniqueIdentifier
  type      String    @db.NVarChar(50)
  title     String    @db.NVarChar(250)
  body      String?   @db.NVarChar(1000)
  link      String?   @db.NVarChar(500)
  dedupeKey String    @map("dedupe_key") @db.NVarChar(200)
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Course {
  id          String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  title       String    @db.NVarChar(250)
  description String?   @db.NVarChar(Max)
  status      String    @default("draft") @db.NVarChar(20)
  publishedAt DateTime? @map("published_at")
  createdById String?   @map("created_by_id") @db.UniqueIdentifier
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  materials   CourseMaterial[]
  sessions    TrainingSession[]
  enrollments CourseEnrollment[]

  @@index([status])
  @@map("courses")
}

model CourseMaterial {
  id          String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  courseId    String   @map("course_id") @db.UniqueIdentifier
  title       String   @db.NVarChar(250)
  kind        String   @default("link") @db.NVarChar(20)
  url         String?  @db.NVarChar(1000)
  storageKey  String?  @map("storage_key") @db.NVarChar(500)
  fileName    String?  @map("file_name") @db.NVarChar(260)
  contentType String?  @map("content_type") @db.NVarChar(120)
  sortOrder   Int      @default(0) @map("sort_order")
  isRequired  Boolean  @default(false) @map("is_required")
  createdAt   DateTime @default(now()) @map("created_at")

  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progress MaterialProgress[]

  @@index([courseId, sortOrder])
  @@map("course_materials")
}

model TrainingSession {
  id            String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  courseId      String   @map("course_id") @db.UniqueIdentifier
  title         String   @db.NVarChar(250)
  presenterName String?  @map("presenter_name") @db.NVarChar(200)
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  meetUrl       String   @map("meet_url") @db.NVarChar(1000)
  status        String   @default("scheduled") @db.NVarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attendances Attendance[]

  @@index([startsAt])
  @@index([courseId])
  @@map("training_sessions")
}

model CourseEnrollment {
  id          String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  courseId    String    @map("course_id") @db.UniqueIdentifier
  dealerId    String    @map("dealer_id") @db.UniqueIdentifier
  status      String    @default("enrolled") @db.NVarChar(20)
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([courseId, dealerId])
  @@index([dealerId])
  @@map("course_enrollments")
}

model Attendance {
  id        String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  sessionId String    @map("session_id") @db.UniqueIdentifier
  dealerId  String    @map("dealer_id") @db.UniqueIdentifier
  joinedAt  DateTime? @map("joined_at")
  source    String    @default("click") @db.NVarChar(20)

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dealer  Dealer          @relation(fields: [dealerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sessionId, dealerId])
  @@map("attendances")
}

model MaterialProgress {
  materialId    String    @map("material_id") @db.UniqueIdentifier
  dealerId      String    @map("dealer_id") @db.UniqueIdentifier
  firstViewedAt DateTime  @default(now()) @map("first_viewed_at")
  completedAt   DateTime? @map("completed_at")

  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dealer   Dealer         @relation(fields: [dealerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([materialId, dealerId])
  @@index([dealerId])
  @@map("material_progress")
}

model QuestionCategory {
  id        String  @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  name      String  @db.NVarChar(200)
  parentId  String? @map("parent_id") @db.UniqueIdentifier
  status    String  @default("active") @db.NVarChar(20)
  sortOrder Int     @default(0) @map("sort_order")

  parent           QuestionCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children         QuestionCategory[] @relation("CategoryTree")
  questions        Question[]
  practiceSessions PracticeSession[]

  @@map("question_categories")
}

model Question {
  id          String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  categoryId  String    @map("category_id") @db.UniqueIdentifier
  stem        String    @db.NVarChar(Max)
  explanation String?   @db.NVarChar(Max)
  difficulty  Int       @default(2)
  status      String    @default("draft") @db.NVarChar(20)
  version     Int       @default(1)
  createdById String?   @map("created_by_id") @db.UniqueIdentifier
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")

  category         QuestionCategory  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  options          QuestionOption[]
  examQuestions    ExamQuestion[]
  attemptQuestions AttemptQuestion[]
  practiceAnswers  PracticeAnswer[]

  @@index([categoryId, status])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  questionId String  @map("question_id") @db.UniqueIdentifier
  text       String  @db.NVarChar(Max)
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @default(0) @map("sort_order")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([questionId])
  @@map("question_options")
}

model Exam {
  id               String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  title            String    @db.NVarChar(250)
  description      String?   @db.NVarChar(Max)
  questionCount    Int       @default(30) @map("question_count")
  durationMinutes  Int       @default(45) @map("duration_minutes")
  passMarkPercent  Int       @default(70) @map("pass_mark_percent")
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  status           String    @default("draft") @db.NVarChar(20)
  selectionMode    String    @default("random") @map("selection_mode") @db.NVarChar(20)
  shuffleOptions   Boolean   @default(true) @map("shuffle_options")
  showScorePolicy  String    @default("after_submit") @map("show_score_policy") @db.NVarChar(30)
  showAnswerPolicy String    @default("after_exam_ends") @map("show_answer_policy") @db.NVarChar(30)
  showLeaderboard  Boolean   @default(false) @map("show_leaderboard")
  createdById      String?   @map("created_by_id") @db.UniqueIdentifier
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  questions   ExamQuestion[]
  assignments ExamAssignment[]
  attempts    ExamAttempt[]

  @@index([status])
  @@map("exams")
}

model ExamQuestion {
  id         String @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  examId     String @map("exam_id") @db.UniqueIdentifier
  questionId String @map("question_id") @db.UniqueIdentifier
  sortOrder  Int    @default(0) @map("sort_order")

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([examId, questionId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamAssignment {
  id         String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  examId     String   @map("exam_id") @db.UniqueIdentifier
  dealerId   String   @map("dealer_id") @db.UniqueIdentifier
  assignedAt DateTime @default(now()) @map("assigned_at")

  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([examId, dealerId])
  @@index([dealerId])
  @@map("exam_assignments")
}

model ExamAttempt {
  id                 String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  examId             String    @map("exam_id") @db.UniqueIdentifier
  dealerId           String    @map("dealer_id") @db.UniqueIdentifier
  userId             String    @map("user_id") @db.UniqueIdentifier
  slotKey            String    @unique @map("slot_key") @db.NVarChar(200)
  attemptNo          Int       @default(1) @map("attempt_no")
  status             String    @default("InProgress") @db.NVarChar(20)
  startedAt          DateTime  @default(now()) @map("started_at")
  deadlineAt         DateTime  @map("deadline_at")
  submittedAt        DateTime? @map("submitted_at")
  finishedAt         DateTime? @map("finished_at")
  lastActivityAt     DateTime? @map("last_activity_at")
  totalQuestions     Int       @map("total_questions")
  correctCount       Int?      @map("correct_count")
  scorePercent       Float?    @map("score_percent")
  isPassed           Boolean?  @map("is_passed")
  voidReason         String?   @map("void_reason") @db.NVarChar(1000)
  voidReasonCategory String?   @map("void_reason_category") @db.NVarChar(50)
  voidedAt           DateTime? @map("voided_at")
  voidedById         String?   @map("voided_by_id") @db.UniqueIdentifier
  createdAt          DateTime  @default(now()) @map("created_at")

  exam      Exam              @relation(fields: [examId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dealer    Dealer            @relation(fields: [dealerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions AttemptQuestion[]
  answers   AttemptAnswer[]

  @@index([examId, status])
  @@index([dealerId, examId])
  @@index([status, deadlineAt])
  @@map("exam_attempts")
}

model AttemptQuestion {
  id         String @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  attemptId  String @map("attempt_id") @db.UniqueIdentifier
  questionId String @map("question_id") @db.UniqueIdentifier
  sortOrder  Int    @map("sort_order")
  points     Int    @default(1)
  snapshot   String @db.NVarChar(Max)

  attempt  ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question Question        @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers  AttemptAnswer[]

  @@unique([attemptId, sortOrder])
  @@unique([attemptId, questionId])
  @@map("attempt_questions")
}

model AttemptAnswer {
  id                String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  attemptId         String   @map("attempt_id") @db.UniqueIdentifier
  attemptQuestionId String   @map("attempt_question_id") @db.UniqueIdentifier
  selectedOptionId  String?  @map("selected_option_id") @db.UniqueIdentifier
  version           Int      @default(0)
  updatedAt         DateTime @default(now()) @map("updated_at")

  attempt         ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attemptQuestion AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([attemptId, attemptQuestionId])
  @@map("attempt_answers")
}

model PracticeSession {
  id            String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  userId        String    @map("user_id") @db.UniqueIdentifier
  dealerId      String    @map("dealer_id") @db.UniqueIdentifier
  categoryId    String?   @map("category_id") @db.UniqueIdentifier
  questionCount Int       @map("question_count")
  answeredCount Int       @default(0) @map("answered_count")
  correctCount  Int       @default(0) @map("correct_count")
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dealer   Dealer            @relation(fields: [dealerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers  PracticeAnswer[]

  @@index([userId, startedAt])
  @@map("practice_sessions")
}

model PracticeAnswer {
  id               String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  sessionId        String    @map("session_id") @db.UniqueIdentifier
  questionId       String    @map("question_id") @db.UniqueIdentifier
  sortOrder        Int       @map("sort_order")
  selectedOptionId String?   @map("selected_option_id") @db.UniqueIdentifier
  isCorrect        Boolean?  @map("is_correct")
  answeredAt       DateTime? @map("answered_at")

  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question Question        @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sessionId, questionId])
  @@map("practice_answers")
}

model ImportJob {
  id           String    @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  uploadedById String    @map("uploaded_by_id") @db.UniqueIdentifier
  fileName     String    @map("file_name") @db.NVarChar(260)
  status       String    @default("previewed") @db.NVarChar(20)
  totalRows    Int       @default(0) @map("total_rows")
  validRows    Int       @default(0) @map("valid_rows")
  errorRows    Int       @default(0) @map("error_rows")
  createdAt    DateTime  @default(now()) @map("created_at")
  committedAt  DateTime? @map("committed_at")
  expiresAt    DateTime  @map("expires_at")

  uploadedBy User        @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rows       ImportRow[]

  @@map("import_jobs")
}

model ImportRow {
  id        String  @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  jobId     String  @map("job_id") @db.UniqueIdentifier
  rowNumber Int     @map("row_number")
  payload   String  @db.NVarChar(Max)
  isValid   Boolean @map("is_valid")
  errors    String? @db.NVarChar(Max)

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([jobId, rowNumber])
  @@map("import_rows")
}

model AuditLog {
  id            String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @db.UniqueIdentifier
  actorUserId   String?  @map("actor_user_id") @db.UniqueIdentifier
  action        String   @db.NVarChar(100)
  entityType    String   @map("entity_type") @db.NVarChar(100)
  entityId      String?  @map("entity_id") @db.NVarChar(100)
  occurredAt    DateTime @default(now()) @map("occurred_at")
  correlationId String?  @map("correlation_id") @db.NVarChar(100)
  details       String?  @db.NVarChar(Max)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([occurredAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
